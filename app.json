{
  "id": "com.walldisplay.dashboard",
  "version": "1.3.64",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#E8001D",
  "name": {
    "en": "Shelly Wall Display Dashboard",
    "de": "Shelly Wall Display Dashboard"
  },
  "description": {
    "en": "Turn any display into your smart home command center",
    "de": "Verwandle jeden Bildschirm in dein Smart Home Kontrollzentrum"
  },
  "tags": {
    "en": [
      "shelly",
      "wall display",
      "dashboard",
      "tablet",
      "camera"
    ],
    "de": [
      "shelly",
      "wanddisplay",
      "dashboard",
      "tablet",
      "kamera"
    ]
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "flow": {
    "actions": [
      {
        "id": "show_camera",
        "title": {
          "en": "Show camera on dashboard",
          "de": "Kamera auf dem Dashboard anzeigen"
        },
        "titleFormatted": {
          "en": "Show [[device]] on [[display]] for [[duration]] s",
          "de": "[[device]] auf [[display]] für [[duration]] s anzeigen"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "device",
            "placeholder": {
              "en": "Select camera…",
              "de": "Kamera auswählen…"
            }
          },
          {
            "type": "autocomplete",
            "name": "display",
            "placeholder": {
              "en": "All displays",
              "de": "Alle Displays"
            }
          },
          {
            "type": "number",
            "name": "duration",
            "title": {
              "en": "Auto-close after (seconds, 0 = stay open)",
              "de": "Automatisch schliessen nach (Sekunden, 0 = offen lassen)"
            },
            "placeholder": {
              "en": "30",
              "de": "30"
            },
            "min": 0,
            "max": 3600,
            "step": 1
          }
        ]
      },
      {
        "id": "show_message",
        "title": {
          "en": "Show message on dashboard",
          "de": "Nachricht auf dem Dashboard anzeigen"
        },
        "titleFormatted": {
          "en": "Show [[message]] on [[display]] for [[duration]] min",
          "de": "[[message]] auf [[display]] für [[duration]] Min. anzeigen"
        },
        "args": [
          {
            "type": "text",
            "name": "message",
            "placeholder": {
              "en": "Take the trash out…",
              "de": "Mülleimer rausstellen…"
            }
          },
          {
            "type": "autocomplete",
            "name": "display",
            "placeholder": {
              "en": "All displays",
              "de": "Alle Displays"
            }
          },
          {
            "type": "number",
            "name": "duration",
            "placeholder": {
              "en": "0",
              "de": "0"
            },
            "min": 0,
            "max": 1440
          }
        ]
      }
    ]
  },
  "api": {
    "getDebugLogs": {
      "method": "GET",
      "path": "/debug/logs"
    },
    "getDebugImages": {
      "method": "GET",
      "path": "/debug/images"
    },
    "postDebugCover": {
      "method": "POST",
      "path": "/debug/cover"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Andi"
  },
  "homepage": "https://github.com/andiwirz/com.walldisplay.dashboard",
  "support": "https://github.com/andiwirz/com.walldisplay.dashboard/issues",
  "source": "https://github.com/andiwirz/com.walldisplay.dashboard",
  "contributing": {
    "donate": {
      "paypal": {
        "username": "AndiWirz"
      }
    }
  }
}
